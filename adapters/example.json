{
  "id": "example",
  "label": "Example host project (copy + edit)",
  "projectRoot": ".",
  "basePath": "/",
  "build": "npm run build",
  "outDir": "shots/7dps",
  "apis": {
    "setCamera": "window.__setCamera",
    "cameraPresets": "window.__cameraPresets",
    "photosphere": "window.__capturePhotosphere"
  },
  "capture": {
    "queryCapture": "capture=1",
    "queryBeauty": "beauty=1",
    "loadingGone": ".loading"
  },
  "defaultQuality": "social",
  "drone": {
    "kind": "orbit",
    "origin": [0, 0, 0],
    "target": [0, 1.2, 0],
    "radius": 8,
    "height": 2.4,
    "fov": 40
  },
  "scripts": {
    "preview": "node tools/capture-stills.mjs",
    "photosphere": "node tools/capture-photosphere.mjs"
  },
  "notes": "Replace projectRoot + apis + scripts. Use 7dps run --quality social --drone orbit."
}
