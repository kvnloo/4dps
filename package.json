{
  "name": "4dps",
  "version": "0.3.1",
  "description": "Designer preview packs for 3D web scenes: 9 stills, grid, 3D/4D photosphere, drone flythrough, quality presets. Capture stays in the host; 7dps plans, grids, encodes, and views via Photo Sphere Viewer.",
  "type": "module",
  "license": "MIT",
  "author": "kvnloo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kvnloo/4dps.git"
  },
  "bugs": {
    "url": "https://github.com/kvnloo/4dps/issues"
  },
  "homepage": "https://github.com/kvnloo/4dps#readme",
  "bin": {
    "7dps": "./bin/7dps.mjs"
  },
  "files": [
    "bin",
    "lib",
    "adapters",
    "viewers",
    "skills",
    "scripts",
    "presets",
    "demo/index.html",
    "fixtures/sample-equirect.png",
    "fixtures/sample-equirect.mp4",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "7dps": "node bin/7dps.mjs",
    "smoke": "node scripts/smoke.mjs",
    "fixtures": "node scripts/make-fixtures.mjs",
    "e2e": "node scripts/e2e-browser.mjs",
    "e2e:install": "npx playwright install chromium",
    "test": "node scripts/smoke.mjs",
    "test:full": "node scripts/smoke.mjs && node scripts/e2e-browser.mjs",
    "check:hq": "node scripts/capture-hq-check.mjs",
    "prepack": "node -e \"const fs=require('fs'); for (const p of ['fixtures/sample-equirect.png','fixtures/sample-equirect.mp4']) { if (!fs.existsSync(p)) { console.error('missing '+p+' — run npm run fixtures'); process.exit(1) } }\"",
    "view:3d": "node bin/7dps.mjs view 3d fixtures/sample-equirect.png",
    "view:4d": "node bin/7dps.mjs view 4d fixtures/sample-equirect.mp4",
    "demo": "node scripts/demo.mjs"
  },

  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "keywords": [
    "photosphere",
    "360",
    "equirectangular",
    "drone",
    "flythrough",
    "photo-sphere-viewer",
    "three.js",
    "webgl",
    "behance",
    "designer",
    "preview"
  ],
  "dependencies": {
    "@photo-sphere-viewer/autorotate-plugin": "^5.14.1",
    "@photo-sphere-viewer/core": "^5.14.1",
    "@photo-sphere-viewer/equirectangular-video-adapter": "^5.14.1",
    "@photo-sphere-viewer/video-plugin": "^5.14.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "playwright": "^1.49.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
