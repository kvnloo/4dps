{
  "name": "7dps",
  "version": "0.3.0",
  "description": "Designer preview packs for 3D web scenes: 9 stills, grid, 3D/4D photosphere, drone flythrough, quality presets. Capture stays in the host; 7dps plans, grids, encodes, and views via Photo Sphere Viewer.",
  "type": "module",
  "license": "MIT",
  "author": "kvnloo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kvnloo/7dps.git"
  },
  "bugs": {
    "url": "https://github.com/kvnloo/7dps/issues"
  },
  "homepage": "https://github.com/kvnloo/7dps#readme",
  "bin": {
    "7dps": "./bin/7dps.mjs"
  },
  "files": [
    "bin",
    "lib",
    "adapters",
    "viewers",
    "skills",
    "scripts",
    "presets",
    "fixtures",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "7dps": "node bin/7dps.mjs",
    "smoke": "node scripts/smoke.mjs",
    "fixtures": "node scripts/make-fixtures.mjs",
    "e2e": "node scripts/e2e-browser.mjs",
    "test": "node scripts/smoke.mjs",
    "test:full": "node scripts/smoke.mjs && node scripts/e2e-browser.mjs",
    "view:3d": "node bin/7dps.mjs view 3d fixtures/sample-equirect.png",
    "view:4d": "node bin/7dps.mjs view 4d fixtures/sample-equirect.mp4"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "photosphere",
    "360",
    "equirectangular",
    "drone",
    "flythrough",
    "photo-sphere-viewer",
    "three.js",
    "webgl",
    "behance",
    "designer",
    "preview"
  ],
  "dependencies": {
    "@photo-sphere-viewer/autorotate-plugin": "^5.14.1",
    "@photo-sphere-viewer/core": "^5.14.1",
    "@photo-sphere-viewer/equirectangular-video-adapter": "^5.14.1",
    "@photo-sphere-viewer/video-plugin": "^5.14.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "playwright": "^1.49.0"
  }
}
