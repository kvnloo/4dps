{
  "name": "7dps",
  "version": "0.2.0",
  "description": "Designer preview packs for 3D web scenes: 9 stills, grid, 3D photosphere, 4D 360° video. Capture stays in the host; 7dps plans, grids, encodes, and views via Photo Sphere Viewer.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "7dps": "./bin/7dps.mjs"
  },
  "files": [
    "bin",
    "lib",
    "adapters",
    "viewers",
    "skills",
    "scripts",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "7dps": "node bin/7dps.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "node scripts/smoke.mjs",
    "view:3d": "node bin/7dps.mjs view 3d",
    "view:4d": "node bin/7dps.mjs view 4d"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "photosphere",
    "360",
    "equirectangular",
    "photo-sphere-viewer",
    "three.js",
    "webgl",
    "behance",
    "designer",
    "preview"
  ],
  "dependencies": {
    "@photo-sphere-viewer/autorotate-plugin": "^5.14.1",
    "@photo-sphere-viewer/core": "^5.14.1",
    "@photo-sphere-viewer/equirectangular-video-adapter": "^5.14.1",
    "@photo-sphere-viewer/video-plugin": "^5.14.1"
  }
}
