    "dof": { "enabled": false }
  },
  "capture": {
    "waitMs": 800,
    "settleFrames": 4,
    "dpr": 1,
    "rejectBlackMean": 0.02,
    "rejectBlackStd": 0.008,
    "note": "Draft only. dpr=1 OK for layout; still reject near-black frames."
  },
  "photosphere": {
    "size": 512,
    "face_size": 512,
    "note": "Layout checks only — not for demo/Behance."
  },
  "4d": {
    "frames": 12,
    "fps": 12,
    "size": 512,
    "note": "Short multi-frame smoke only."
