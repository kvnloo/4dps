{
  "id": "draft",
  "label": "Draft / iterate",
  "description": "Fast software-GL friendly. For layout and camera checks only — not HQ showcase.",
  "quality": {
    "width": 1280,
    "height": 720,
    "dpr": 1,
    "antialias": true,
    "multisampling": 0,
    "shadowMapSize": 512,
