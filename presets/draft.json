    "noise": { "enabled": false, "opacity": 0 },
    "dof": { "enabled": false }
  },
  "capture": {
    "waitMs": 800,
    "settleFrames": 4,
    "rejectBlackMean": 0.02
  },
  "photosphere": { "size": 512 },
  "4d": { "frames": 12, "fps": 12, "size": 512 },
  "drone": { "frames": 24, "fps": 24, "width": 1280, "height": 720 }
